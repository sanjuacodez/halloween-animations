{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "halloween-animations/countdown",
	"title": "Countdown Timer",
	"category": "widgets",
	"icon": "clock",
	"description": "A live countdown to a sale, launch or event. Uses your site's timezone so every visitor counts down to the same moment.",
	"keywords": [ "countdown", "timer", "sale", "black friday", "event" ],
	"textdomain": "halloween-animations",
	"supports": {
		"html": false,
		"align": false
	},
	"attributes": {
		"end": { "type": "string", "default": "" },
		"title": { "type": "string", "default": "" },
		"style": { "type": "string", "default": "rounded" },
		"size": { "type": "string", "default": "medium" },
		"labels": { "type": "string", "default": "long" },
		"align": { "type": "string", "default": "center" },
		"showSeconds": { "type": "boolean", "default": true },
		"bgColor": { "type": "string", "default": "#1e1e1e" },
		"textColor": { "type": "string", "default": "#ffffff" },
		"expiredText": { "type": "string", "default": "This offer has ended." }
	},
	"editorScript": "ha-countdown-block-editor",
	"style": "ha-countdown-timer"
}

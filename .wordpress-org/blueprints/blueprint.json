{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "landingPage": "/wp-admin/admin.php?page=seasonal-effects",
  "preferredVersions": {
    "php": "8.1",
    "wp": "6.8"
  },
  "features": {
    "networking": true
  },
  "steps": [
    {
      "step": "login",
      "username": "admin"
    },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "wordpress.org/plugins",
        "slug": "halloween-animations"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "setSiteOptions",
      "options": {
        "blogname": "Seasonal Effects & Notice bar Plugin Demo",
        "blogdescription": "Experience spooky animations and atmospheric sounds! with Notice Bar"
      }
    }
  ]
}